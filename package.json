{
  "name": "pdf-export-plus",
  "version": "0.1.0",
  "description": "Export polished Obsidian PDFs with page-bottom footnotes and professional typography.",
  "main": "main.js",
  "scripts": {
    "embed": "node scripts/embed-vivliostyle.mjs",
    "dev": "npm run embed && node esbuild.config.mjs",
    "build": "npm run embed && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "npm run embed && tsc -noEmit -skipLibCheck"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "pdf",
    "footnotes",
    "vivliostyle"
  ],
  "author": "Boris Nezlobin",
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.20.2",
    "obsidian": "latest",
    "tslib": "^2.6.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@vivliostyle/core": "^2.44.1",
    "pdf-lib": "^1.17.1"
  }
}
